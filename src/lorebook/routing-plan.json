{
  "version": "0.2.0",
  "entries": [
    {
      "id": "core_narrative_contract",
      "label": "核心叙事与玩家权边界",
      "activation": "always",
      "target": "plot-model",
      "source": "../card/identity.xml",
      "budget": "high-priority"
    },
    {
      "id": "variable_output_format",
      "label": "JSONPatch 输出格式",
      "activation": "always-for-variable-stage",
      "target": "variable-model",
      "source": "variable-output-format.md",
      "budget": "high-priority",
      "contract": "每轮只输出一个 UpdateVariable/JSONPatch；无合法变化时输出空数组；不得写 interaction.visit_memory。"
    },
    {
      "id": "current_state_projection",
      "label": "当前状态投影",
      "activation": "runtime-generated",
      "target": "variable-model",
      "source": "model-projection.md",
      "budget": "dynamic"
    },
    {
      "id": "variable_update_protocol",
      "label": "JSONPatch 更新规则",
      "activation": "always-for-variable-stage",
      "target": "variable-model",
      "source": "variable-update-rules.md",
      "budget": "high-priority",
      "contract": "只写获授权的开放语义字段；interaction.visit_memory 与全部确定性状态由 bridge 独占。"
    },
    {
      "id": "gal_presentation_protocol",
      "label": "GAL 表现与交互会话协议",
      "activation": "always-for-plot-stage; request-specific-envelope-is-runtime-injected",
      "target": "plot-model",
      "source": "gal-presentation-protocol.md",
      "budget": "high-priority-during-interaction"
    },
    {
      "id": "moving_garden_setting",
      "label": "移动庭园核心设定",
      "activation": "always",
      "target": "plot-model",
      "source": "core/moving-garden.xml",
      "budget": "medium"
    },
    {
      "id": "gensokyo_basics_setting",
      "label": "幻想乡基础世界观",
      "activation": "always",
      "target": "plot-model",
      "source": "core/gensokyo-basics.xml",
      "budget": "low"
    },
    {
      "id": "character_profiles",
      "label": "当前相关角色人设",
      "activation": "greenlight-by-character-id",
      "target": "plot-model",
      "source": "characters/{character_id}.xml",
      "routing_source": "character-routing.json",
      "budget": "dynamic",
      "contract": "绿灯只由本地剧情上下文根据正式在场、当前会话、当前事件或显式代码选角写入，并通过 position:none/should_scan:true 的不可见扫描胶囊触发；姓名、别名、历史记录与未在场名单不触发；角色条目不参与或诱发递归扫描。"
    },
    {
      "id": "item_profiles",
      "label": "本轮获授权的道具档案",
      "activation": "greenlight-by-authorized-item-id",
      "target": "plot-model",
      "source": "items/{item_id}.xml",
      "routing_source": "item-routing.json",
      "budget": "dynamic",
      "contract": "只把本轮已由本地道具选择器授权的道具绿灯写入不可见扫描胶囊；库存名称、历史消息、脱敏投影与未选中道具不触发。"
    },
    {
      "id": "sakuya_watch_active_effect",
      "label": "咲夜怀表生效边界",
      "activation": "runtime-generated-when-time-stop-active",
      "target": "plot-model",
      "source": "ui/prompt-context.ts",
      "budget": "dynamic"
    },
    {
      "id": "event_configs",
      "label": "当前事件配置",
      "activation": "conditional-by-config-id",
      "target": "plot-model",
      "source": "events/greenhouse-vertical-slice.json",
      "budget": "dynamic"
    },
    {
      "id": "database_recall",
      "label": "可选数据库回忆",
      "activation": "runtime-optional",
      "target": "plot-model",
      "source": "database-adapter",
      "budget": "max-3-items-1200-zh-chars"
    },
    {
      "id": "opening_first_response",
      "label": "确定性开场后的首次行动引导",
      "activation": "first-action-after-opening",
      "target": "plot-model",
      "source": "../card/opening-first-response.xml",
      "budget": "high-priority-once"
    }
  ]
