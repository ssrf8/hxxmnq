{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@card/memory-adapter": ["src/ui/memory-adapters/standalone-mvu.ts"]
    }
  },
  "include": ["src/ui/**/*.ts", "src/battle/**/*.ts"]
}
